<rml>
    <head>
        <title>TurboBarCam HUD</title>
        <style>
            body, div, span, p, img {
                font-family: "Exo 2";
                font-size: 13dp;
            }

            body {
                height: 100%;
                pointer-events: none;
                color: white;
            }
        </style>
        <link type="text/rcss" href="gui_turbobarcam_hud.rcss"/>
    </head>
    <body id="turbobarcam-hud-body">

    <div id="ff-box" data-model="turbobarcam_hud_model" data-if="ffVisible">
        <div class="ff-icon" data-style-opacity="ffOpacity">&gt;&gt;&gt;</div>

        <div class="ff-speed-text">x{{ ffSpeed }}</div>

        <div class="ff-progress-bg" data-if="ffShowProgress">
            <div class="ff-progress-fill" data-style-width="ffProgress + '%'"></div>
        </div>
    </div>

    <div id="hud-box" data-model="turbobarcam_hud_model" data-if="visible">

        <div class="icon-box">
            <img class="unit-icon" data-attr-src="icon"/>
        </div>

        <div class="info-box">
            <img class="rank-overlay" data-if="hasRank" data-attr-src="rankIcon"/>

            <div class="header-row">
                <div class="unit-name">{{ name }}</div>
                <div class="unit-desc">{{ desc }}</div>
            </div>

            <div class="bar-container">
                <div class="stats-row">
                    <span class="stat-item" data-if="kills > 0">Kills: {{ kills }}</span>
                    <span class="bonus-val" data-if="hpBonus > 0">HP +{{ hpBonus }}%</span>
                    <span class="bonus-val" data-if="reloadBonus > 0">Dps +{{ reloadBonus }}%</span>
                    <span class="bonus-val" data-if="rangeBonus > 0">Range {{ rangeBonus }}</span>

                    <div class="emp-timer" data-if="hasRank">
                        <span data-if="showEmpTimer">EMP: {{ empTime }}s</span>
                    </div>
                </div>

                <div class="hp-bar-bg">
                    <div class="hp-bar-fill" data-style-width="hpPct + '%'"></div>
                    <div class="emp-bar-fill"
                         data-style-width="empPct + '%'"
                         data-style-background-color="empColor">
                    </div>
                    <div class="hp-text">
                        {{ currHp }} / {{ maxHp }}
                    </div>
                </div>

                <div class="xp-bar-bg">
                    <div class="xp-bar-fill" data-style-width="xpPct + '%'"></div>
                </div>

            </div>

        </div>
    </div>


    <div id="player-list-wrapper" data-model="turbobarcam_hud_model" data-style-opacity="playerListOpacity">

        <div class="team-panel left" data-style-opacity="teamAOpacity">
            <div class="player-row" data-for="player : teamA_players">
                <div class="player-color-box" data-style-background-color="player.color"></div>
                <img class="player-rank" data-attr-src="player.rankIcon"/>
                <span class="player-skill">{{ player.skill }}</span>
                <span class="player-name">{{ player.name }}</span>
            </div>
        </div>

        <div class="team-panel right" data-style-opacity="teamBOpacity">
            <div class="player-row" data-for="player : teamB_players">
                <span class="player-name">{{ player.name }}</span>
                <span class="player-skill">{{ player.skill }}</span>
                <img class="player-rank" data-attr-src="player.rankIcon"/>
                <div class="player-color-box" data-style-background-color="player.color"></div>
            </div>
        </div>

    </div>

    <div id="projectile-info-container" data-model="turbobarcam_hud_model" data-if="projectilesVisible">
        <table class="projectile-table">
            <tr>
                <th>Id</th>
                <th>OwnerId</th>
                <th>Time</th>
            </tr>
            <tr data-for="projectile : trackedProjectiles">
                <td>{{ projectile.id }}</td>
                <td>{{ projectile.ownerId }}</td>
                <td>{{ projectile.time }}</td>
            </tr>
        </table>
    </div>

    <div id="script-info-container" data-model="turbobarcam_hud_model" data-if="scriptStepsVisible">

        <div class="script-card" data-for="step : scriptSteps">
            <div class="script-card-header">
                &lt;{{ step.label }} Step Frame: {{ step.frame }}&gt;
            </div>
            <div class="script-card-body">
                <div class="script-cmd-line" data-for="cmd : step.commandsList">
                    {{ cmd }}
                </div>
            </div>
        </div>

    </div>

    <div id="status-bar" data-model="turbobarcam_hud_model" data-if="statusVisible">
        <div class="status-left">
            <span class="console-value">{{ lastConsoleMsg }}</span>
        </div>
        <div class="status-right">
            <span class="status-value">{{ statusInfo }}</span>
            <span class="mouseTarget">{{ currentMouseTarget }}</span>
            <span class="time">{{ gameTime }} (x{{ targetSpeed }})</span>
            <span class="frame">{{ gameFrame }}</span>
        </div>
    </div>
    </body>
</rml>
