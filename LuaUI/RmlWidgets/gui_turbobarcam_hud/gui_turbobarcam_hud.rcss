body {
    font-family: "Exo 2";
    font-weight: normal;
    font-size: 13dp;
    color: white;
    height: 100%;
}

div {
    display: block;
}

#status-bar {
    width: 2000dp;
    height: 20dp;
    font-size: 12dp;
    font-family: "Exo 2";
    background-color: black;

    position: absolute;
    bottom: 0dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    box-sizing: border-box;
    padding: 0dp 10dp;

    overflow: hidden;
}

.status-left {
    width: 800dp;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-align: left;
}

.status-label {
    color: #888;
    margin-right: 5dp;
}

.time {
    color: #fff;
    font-weight: bold;
    width: 140dp;
}

.mouseTarget {
    color: #fff;
    width: 70dp;
}

.frame {
    color: #fff;
    width: 40dp;
}

.status-info {
    color: #fff;
    margin: 10dp;
}

.status-right {
    color: #fff;
    display: flex;
    flex-direction: row;
    gap: 15dp;
}

.console-value {
    font-size: 12dp;
    color: #fff;
}

#projectile-info-container {
    width: 300dp;
    height: auto;

    position: absolute;
    top: 100dp;
    left: 1700dp;

    background-color: rgba(0,0,0,30);
    border: 1dp #2c2c2c;
    box-shadow: 2dp 2dp 6dp rgba(0,0,0,30);

    padding: 20dp;

    display: flex;
    flex-direction: column;
    align-items: center;

    z-index: 10;

    color: #ffffff;
}

.projectile-table {
    display: table;
    width: 100%;
    box-sizing: border-box;
}

.projectile-table tr {
    display: table-row;
}

.projectile-table th,
.projectile-table td {
    display: table-cell;
    padding: 10dp;
    text-align: left;
    vertical-align: middle;
}

.projectile-table th {
    color: #fdc04c;
    border-bottom: 2dp #fdc04c;
    font-weight: bold;
}

.projectile-table td {
    border-bottom: 1dp #2c2c2c;
}

.projectile-table tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 30);
}

#script-info-container {
    width: 600dp;
    height: auto;
    position: absolute;
    top: 40dp;
    left: 565dp;

    background-color: rgba(0, 0, 0, 100);
    padding: 0dp;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10dp;

    z-index: 10;
    color: #ffffff;
}

.script-card {
    display: block;
    width: 100%;
    background-color: rgba(0,0,0,0.85);
    border: 1dp #2c2c2c;
    border-left: 3dp #fdc04c;
    padding: 10dp;
    box-sizing: border-box;
    box-shadow: 2dp 2dp 4dp rgba(0,0,0,0.5);
}

.script-card-header {
    font-size: 14dp;
    font-weight: bold;
    color: #fdc04c;
    margin-bottom: 5dp;
    border-bottom: 1dp #444;
    padding-bottom: 3dp;
}

.script-card-body {
    display: flex;
    flex-direction: column;
}

.script-cmd-line {
    font-size: 13dp;
    color: #ddd;
}

#vet-panel {
    position: absolute;
    width: 200dp;
    top: 160dp;
    left: 56dp;

    background-color: rgba(26, 26, 26, 230);
    border: 1dp #2c2c2c;
    border-top: 3dp #fdc04c;
    padding: 10dp;
    box-shadow: 2dp 2dp 6dp rgba(0,0,0,140);
}

.vet-header {
    font-weight: bold;
    color: #fdc04c;
    margin-bottom: 5dp;
    border-bottom: 1dp #444;
}

.vet-row {
    display: flex;
    justify-content: space-between;
    margin-top: 3dp;
}

.vet-row .label {
    color: #aaa;
}

.vet-row .value {
    color: #fff;
    font-weight: bold;
}
